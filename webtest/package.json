{
  "name": "loopforge-webtest",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=4 'tests/**/*.test.mjs'",
    "coverage": "c8 --all --reporter=text-summary --reporter=text --reporter=json --reporter=json-summary --reports-dir=coverage npm test && node scripts/check-coverage.mjs"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "26.1.0",
    "v8-to-istanbul": "9.3.0"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
