# Objects, config and logs stay out. HEAD and refs stay in so a plain
# `docker build` can stamp the commit without a --build-arg.
.git/objects
.git/logs
.git/hooks
.git/info
.git/modules
.git/worktrees
.git/lfs
.git/config
.git/index
.git/COMMIT_EDITMSG
.git/FETCH_HEAD
.git/ORIG_HEAD
.git/description
.git/cursor
.env*
.local
upstream.json
upstream-overrides.json
scripts/check-upstream.py
.data
local
node_modules
**/node_modules
e2e/test-results
bin
web/native-chat
*.log

!web/vscode-web/**/node_modules/
!web/vscode-web/**

# Local acceptance credentials and generated reports never enter build layers.
e2e/.auth
e2e/playwright-report
e2e/test-results
**/__pycache__
**/.venv
**/*.pyc
