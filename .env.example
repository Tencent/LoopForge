# Run bash scripts/configure.sh to generate unique local database/session secrets.
AGENTFLOW_HTTP_PORT=8090
AGENTFLOW_MYSQL_DSN=loopforge:REPLACE_ME@tcp(127.0.0.1:33315)/loopforge
AGENTFLOW_SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
AGENTFLOW_AUTH_REQUIRED=true
LOOPFORGE_DB_PASSWORD=REPLACE_ME
LOOPFORGE_DB_ROOT_PASSWORD=REPLACE_ME
LOOPFORGE_MYSQL_PORT=33315
# Optional public address reachable from execution containers/runners:
AGENTFLOW_PLATFORM_MCP_URL=
# Optional model IDs available to your CodeBuddy account (comma-separated):
AGENTFLOW_ASSISTANT_MODELS=
AGENTFLOW_ASSISTANT_MODEL=
# Worker separation, installed runners and preview settings retain AGENTFLOW_ names.
# See docs/deployment.md. Production HTTPS: AGENTFLOW_SECURE_COOKIES=true.
